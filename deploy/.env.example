# Copy to /home/ubuntu/portfolio/.env on the VPS and fill in. chmod 600.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Gmail account that sends the mail. SMTP_PASS is a Google *app password*
# (Google account > Security > 2-Step Verification > App passwords), not the
# account password.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# where contact messages arrive
CONTACT_EMAIL=ruizvicente@proton.me
# image tag to run: latest (main) or a branch name such as new-design-end-2026
PORTFOLIO_TAG=latest
