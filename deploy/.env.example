# Copy to /home/ubuntu/portfolio/.env on the VPS and fill in. chmod 600.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SMTP_USER=
SMTP_PASS=
# optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
CONTACT_EMAIL=
# image tag to run: latest (main) or a branch name such as new-design-end-2026
PORTFOLIO_TAG=latest
